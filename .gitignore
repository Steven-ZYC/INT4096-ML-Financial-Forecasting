# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Virtual environments (never commit an environment or a symlink to one)
.venv
venv/
.venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Secrets
.env
*.key
*.pem

# Raw provider envelopes are large and reproducible; normalized snapshots and
# their manifests ARE committed because they pin every reported number.
data/raw/*_raw_provider.json

# Run outputs: manifests, metrics, configs, environment and predictions are small
# and are kept as evidence. Figures and their caption files are regenerated by
# scripts/reproduce.sh and would otherwise churn on every re-run (matplotlib
# embeds a timestamp and captions carry the new run IDs).
experiments/figures/*.png
experiments/figures/*.caption.txt
experiments/models/*/*/error.log
# Smoke runs of the supplementary test are throwaway checks.
experiments/supplementary/*/*_smoke/

# LaTeX build artefacts. Only the final PDFs are tracked:
#   deliverables/presentation/INT4096_Presentation.pdf
#   deliverables/report/INT4096_Final_Report.pdf
#   deliverables/presentation/script/speaker_script_bilingual.pdf
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*-blx.bib
*.run.xml
deliverables/presentation/slides/main.pdf
deliverables/report/latex/main.pdf
# Generated from speaker_script_bilingual.md by scripts/build_script_pdf.py
deliverables/presentation/script/speaker_script_bilingual.tex

# Personal data: member names + student IDs are kept local only.
# Student IDs must never enter a commit (see docs/project/github_push.md).
docs/project/.members.local
*.local
