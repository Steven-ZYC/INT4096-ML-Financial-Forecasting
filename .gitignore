# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Virtual environments (never commit an environment or a symlink to one)
.venv
venv/
.venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Secrets
.env
*.key
*.pem

# Raw provider envelopes are large and reproducible; normalized snapshots and
# their manifests ARE committed because they pin every reported number.
data/raw/*_raw_provider.json

# Run outputs: manifests, metrics, configs, environment and predictions are small
# and are kept as evidence. Figures and their caption files are regenerated by
# scripts/reproduce.sh and would otherwise churn on every re-run (matplotlib
# embeds a timestamp and captions carry the new run IDs).
artifacts/figures/*.png
artifacts/figures/*.caption.txt
artifacts/experiments/*/error.log

# LaTeX build artefacts (the compiled PDF in reports/final IS tracked)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
reports/latex/generated/*.aux

# Personal data: member names + student IDs are kept local only.
# Student IDs must never enter a commit (see docs/handoff/github_push.md).
docs/management/.members.local
*.local

# Beamer build artefacts (the compiled deck in slides/final IS tracked)
slides/latex/*.aux
slides/latex/*.log
slides/latex/*.nav
slides/latex/*.out
slides/latex/*.snm
slides/latex/*.toc
slides/latex/*.vrb
slides/latex/*.fls
slides/latex/*.fdb_latexmk

# Generated from speaker_script_bilingual.md by scripts/build_script_pdf.py
docs/presentation/speaker_script_bilingual.tex
docs/presentation/speaker_script_bilingual.aux
docs/presentation/speaker_script_bilingual.log
docs/presentation/speaker_script_bilingual.out
