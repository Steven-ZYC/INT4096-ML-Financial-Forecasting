# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Virtual environments (never commit an environment or a symlink to one)
.venv
venv/
.venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Secrets
.env
*.key
*.pem

# Raw provider envelopes are large and reproducible; normalized snapshots and
# their manifests ARE committed because they pin every reported number.
data/raw/*_raw_provider.json

# Run outputs: manifests, metrics, configs, environment and predictions are small
# and are kept as evidence. Figures and their caption files are regenerated by
# scripts/reproduce.sh and would otherwise churn on every re-run (matplotlib
# embeds a timestamp and captions carry the new run IDs).
artifacts/figures/*.png
artifacts/figures/*.caption.txt
artifacts/experiments/*/error.log

# LaTeX build artefacts (the compiled PDF in reports/final IS tracked)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
reports/latex/generated/*.aux
